<IfModule mod_php.c>
    php_value upload_max_filesize 5120M
    php_value post_max_size 5120M
    php_value memory_limit 5120M
    php_value max_execution_time 7200
    php_value max_input_time 7200
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 5120M
    php_value post_max_size 5120M
    php_value memory_limit 5120M
    php_value max_execution_time 7200
    php_value max_input_time 7200
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 5120M
    php_value post_max_size 5120M
    php_value memory_limit 5120M
    php_value max_execution_time 7200
    php_value max_input_time 7200
</IfModule>

<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-XSRF-Token, App-Version"
    Header always set Access-Control-Expose-Headers "Accept-Ranges, Content-Encoding, Content-Length, Content-Range"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle OPTIONS method for CORS preflight immediately
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ index.php [QSA,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder (ONLY for GET/HEAD to protect POST/PUT payloads)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Block direct access to backup files, databases, archives, and environment files (ZIP allowed for SCORM lesson files)
    RewriteRule \.(tar\.gz|tgz|rar|7z|sql|bak|backup|old|env.*)$ - [F,L,NC]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "(^\..*|\.tar\.gz|\.rar|\.7z|\.sql|\.bak|\.backup|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
